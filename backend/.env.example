# ============================================================
#  Configuration backend - LDMFAB
# ============================================================

# --- Base de donnees ---
# DEV (SQLite local) :
# DATABASE_URL="file:./dev.db"
#
# PRODUCTION (Supabase PostgreSQL) :
DATABASE_URL="postgresql://postgres:[MOT_DE_PASSE]@db.xxxx.supabase.co:5432/postgres"

# --- Serveur ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN="https://ldmfab.vercel.app"

# --- Securite / JWT (CHANGER EN PRODUCTION - chaines aleatoires longues) ---
JWT_ACCESS_SECRET="CHANGER-MOI-secret-acces-longue-chaine-aleatoire"
JWT_REFRESH_SECRET="CHANGER-MOI-secret-refresh-longue-chaine-aleatoire"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="8h"

# --- Politique mot de passe / verrouillage compte (21 CFR Part 11) ---
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Compte administrateur initial (cree par le seed) ---
ADMIN_EMAIL="admin@ldmfab.local"
ADMIN_PASSWORD="Admin@12345!"
ADMIN_MATRICULE="ADM-0001"
