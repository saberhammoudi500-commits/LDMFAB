# ============================================================
#  Configuration backend - LDMFAB
# ============================================================

# --- Base de donnees ---
# DEV (par defaut, demarre sans serveur) : SQLite
DATABASE_URL="file:./dev.db"
#
# PRODUCTION : PostgreSQL (changer aussi provider = "postgresql"
# dans prisma/schema.prisma puis relancer `npm run db:setup`)
# DATABASE_URL="postgresql://user:password@localhost:5432/ldmfab?schema=public"

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- Securite / JWT (CHANGER EN PRODUCTION) ---
JWT_ACCESS_SECRET="change-me-access-secret-please-use-a-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-please-use-a-long-random-string"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="8h"

# --- Politique mot de passe / verrouillage compte (21 CFR Part 11) ---
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- Compte administrateur initial (cree par le seed) ---
ADMIN_EMAIL="admin@ldmfab.local"
ADMIN_PASSWORD="Admin@12345"
ADMIN_MATRICULE="ADM-0001"
