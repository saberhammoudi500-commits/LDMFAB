// ============================================================
//  Schema Prisma - LDMFAB v2.0
//  Management Fabrication pharmaceutique - CDC-PROD-PHARMA-2026-V1.0
//  Modules M1-M11 (BPF / GMP / ALCOA+ / 21 CFR Part 11)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
//  M1 - REFERENTIELS ET DONNEES DE BASE
// ============================================================

model DonneurOrdre {
  id          String   @id @default(cuid())
  code        String   @unique
  nom         String
  description String?
  actif       Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  produits   Produit[]
  pdpLignes  PdpLigne[]
}

model FormeGalenique {
  id   String @id @default(cuid())
  code String @unique
  nom  String

  produits Produit[]
}

model Produit {
  id               String   @id @default(cuid())
  codePF           String   @unique
  designation      String
  donneurOrdreId   String
  formeGaleniqueId String
  activite         String?
  uniteConditionnement String?
  nbUnitesParBoite     Int?
  tailleStandardLot    Float?
  dureeVie             Int?
  aql                  String?
  actif                Boolean  @default(true)
  deletedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  donneurOrdre     DonneurOrdre   @relation(fields: [donneurOrdreId], references: [id])
  formeGalenique   FormeGalenique @relation(fields: [formeGaleniqueId], references: [id])

  cadences          Cadence[]
  pcsuHistorique    Pcsu[]
  phasesStandard    PhaseStandard[]
  pdpLignes         PdpLigne[]
  ordresFabrication OrdreFabrication[]

  @@index([codePF])
  @@index([donneurOrdreId])
}

model Equipement {
  id       String   @id @default(cuid())
  code     String   @unique
  nom      String
  atelier  String
  type     String?
  actif    Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cadences          Cadence[]
  phasesRealisation PhaseRealisation[]
  conditionnements  Conditionnement[]
}

model Cadence {
  id            String   @id @default(cuid())
  produitId     String
  equipementId  String
  typeOperation String
  uniteHeure    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  produit    Produit    @relation(fields: [produitId], references: [id])
  equipement Equipement @relation(fields: [equipementId], references: [id])

  @@unique([produitId, equipementId, typeOperation])
}

model PhaseStandard {
  id        String  @id @default(cuid())
  produitId String
  phase     String
  qteCible  Float

  produit   Produit @relation(fields: [produitId], references: [id])

  @@unique([produitId, phase])
}

model Pcsu {
  id        String   @id @default(cuid())
  produitId String
  activite  String?
  valeur    Float
  dateEffet DateTime
  deletedAt DateTime?
  createdAt DateTime @default(now())

  produit   Produit  @relation(fields: [produitId], references: [id])

  @@index([produitId, dateEffet])
}

// ============================================================
//  M2 - PLANIFICATION (PDP)
// ============================================================

model Pdp {
  id        String   @id @default(cuid())
  annee     Int
  mois      Int
  valide    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lignes     PdpLigne[]
  calendrier CalendrierJour[]

  @@unique([annee, mois])
}

model PdpLigne {
  id             String @id @default(cuid())
  pdpId          String
  produitId      String
  donneurOrdreId String

  planQteFab    Float? @default(0)
  planQteCndt   Float? @default(0)
  planValeur    Float? @default(0)
  realiseFab    Float? @default(0)
  realiseCndt   Float? @default(0)
  realiseValeur Float? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pdp          Pdp          @relation(fields: [pdpId], references: [id])
  produit      Produit      @relation(fields: [produitId], references: [id])
  donneurOrdre DonneurOrdre @relation(fields: [donneurOrdreId], references: [id])

  @@unique([pdpId, produitId])
}

model CalendrierJour {
  id    String   @id @default(cuid())
  pdpId String
  date  DateTime @db.Date
  type  String

  pdp   Pdp      @relation(fields: [pdpId], references: [id])

  @@unique([pdpId, date])
}

// ============================================================
//  M3 - ORDRES DE FABRICATION
// ============================================================

model OrdreFabrication {
  id        String @id @default(cuid())
  numeroOF  String @unique
  produitId String
  numeroLot String

  receptionOF   DateTime?
  finValiditeOF DateTime?
  tailleLoT     Float?
  qteTheorique  Float?

  // Workflow: RECU -> EN_COURS -> SF_DECLARE -> CONDITIONNE -> CLOTURE
  workflowStatus String @default("RECU")

  dateDeclarationSF DateTime?
  qteSF             Float?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  produit    Produit @relation(fields: [produitId], references: [id])
  createdBy  User?   @relation("OFCreatedBy", fields: [createdById], references: [id])

  prolongations     ProlongationOF[]
  phasesRealisation PhaseRealisation[]
  conditionnement   Conditionnement?
  ddl               DossierLot?
  signatures        ElectronicSignature[]
  auditLogs         AuditLog[]            @relation("AuditOF")

  @@index([produitId])
  @@index([numeroLot])
  @@index([workflowStatus])
  @@index([finValiditeOF])
}

model ProlongationOF {
  id              String   @id @default(cuid())
  ofId            String
  dateDemande     DateTime @default(now())
  dateFinActuelle DateTime?
  dureeTraitement Int?
  observation     String?
  statut          String   @default("EN_ATTENTE")
  traitePar       String?
  traiteAt        DateTime?

  of OrdreFabrication @relation(fields: [ofId], references: [id])
}

// ============================================================
//  M4 - SUIVI FABRICATION PAR PHASE ET ATELIER
// ============================================================

model PhaseRealisation {
  id            String   @id @default(cuid())
  ofId          String
  phase         String   // PESEE | GRANULATION | MELANGE | COMPRESSION | GELULE | PELLICULAGE | CREME
  equipementId  String?

  dateDebut     DateTime?
  dateFin       DateTime?

  qteEntreeKg   Float?
  qteSortieKg   Float?
  qteEntreeUn   Float?
  qteSortieUn   Float?

  rendementKg   Float?
  rendementUn   Float?
  avarieKg      Float?
  avarieUn      Float?

  operateurId   String?
  superviseurId String?

  statut        String  @default("EN_COURS")
  observation   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  of            OrdreFabrication @relation(fields: [ofId], references: [id])
  equipement    Equipement?      @relation(fields: [equipementId], references: [id])
  operateur     User?            @relation("PhaseOperateur", fields: [operateurId], references: [id])
  superviseur   User?            @relation("PhaseSuperviseur", fields: [superviseurId], references: [id])

  @@unique([ofId, phase])
  @@index([ofId])
}

// ============================================================
//  M5 - SUIVI CONDITIONNEMENT
// ============================================================

model Conditionnement {
  id            String   @id @default(cuid())
  ofId          String   @unique
  equipementId  String?

  dateDebutCndt DateTime?
  dateFinCndt   DateTime?

  qteFabrique   Float?
  qteCndt       Float?
  qteRestante   Float?
  tauxCndt      Float?

  operateurId   String?
  superviseurId String?
  statut        String   @default("EN_ATTENTE")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  of            OrdreFabrication @relation(fields: [ofId], references: [id])
  equipement    Equipement?      @relation(fields: [equipementId], references: [id])
  operateur     User?            @relation("CndtOperateur", fields: [operateurId], references: [id])
  superviseur   User?            @relation("CndtSuperviseur", fields: [superviseurId], references: [id])

  @@index([statut])
}

// ============================================================
//  M7 - DOSSIERS DE LOT (DDL)
// ============================================================

model DossierLot {
  id             String   @id @default(cuid())
  ofId           String   @unique
  verificateurId String?

  dateEmission     DateTime?
  dateEnvoi        DateTime?
  dateReception    DateTime?
  dateVerification DateTime?
  dateValidation   DateTime?

  dateEnvoiRectif     DateTime?
  dateReceptionRectif DateTime?
  dateRenvoi          DateTime?

  statut      String  @default("A_EMETTRE")
  observation String?
  joursAttente Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  of           OrdreFabrication @relation(fields: [ofId], references: [id])
  verificateur User?            @relation("DDLVerificateur", fields: [verificateurId], references: [id])
}

// ============================================================
//  M9 - EFFECTIFS (HC)
// ============================================================

model Employe {
  id          String   @id @default(cuid())
  matricule   String   @unique
  nom         String
  prenom      String
  typeContrat String
  grade       String
  fonction    String?
  service     String?
  managerId   String?
  actif       Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager     Employe?  @relation("Organigramme", fields: [managerId], references: [id])
  subordonnes Employe[] @relation("Organigramme")
}

model BudgetPoste {
  id        String   @id @default(cuid())
  annee     Int
  grade     String
  fonction  String?
  qteBudget Int
  qteActuel Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([annee, grade, fonction])
}

// ============================================================
//  UTILISATEURS / ROLES / RBAC
// ============================================================

model User {
  id        String  @id @default(cuid())
  matricule String  @unique
  email     String  @unique
  firstName String
  lastName  String
  service   String?

  passwordHash       String
  mustChangePassword Boolean  @default(true)
  passwordChangedAt  DateTime @default(now())

  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  signatures    ElectronicSignature[]
  auditLogs     AuditLog[]            @relation("AuditActor")
  ofCreated     OrdreFabrication[]    @relation("OFCreatedBy")
  rolesAssigned UserRole[]            @relation("RoleAssignedBy")

  phasesOperateur   PhaseRealisation[] @relation("PhaseOperateur")
  phasesSuperviseur PhaseRealisation[] @relation("PhaseSuperviseur")
  cndtOperateur     Conditionnement[]  @relation("CndtOperateur")
  cndtSuperviseur   Conditionnement[]  @relation("CndtSuperviseur")
  ddlVerificateur   DossierLot[]       @relation("DDLVerificateur")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  permissions String  @default("[]")
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  assignedAt   DateTime @default(now())
  assignedById String?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id])

  @@unique([userId, roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
//  PISTE D'AUDIT (Audit Trail) - 21 CFR Part 11 / ALCOA+
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  userId    String?
  userLabel String?

  action    String
  entity    String
  entityId  String?

  reason    String?
  oldValue  String?
  newValue  String?
  ipAddress String?

  ofId String?

  user User?             @relation("AuditActor", fields: [userId], references: [id])
  of   OrdreFabrication? @relation("AuditOF", fields: [ofId], references: [id])

  @@index([entity, entityId])
  @@index([timestamp])
  @@index([userId])
}

// ============================================================
//  SIGNATURES ELECTRONIQUES - 21 CFR Part 11
// ============================================================

model ElectronicSignature {
  id        String   @id @default(cuid())
  signedAt  DateTime @default(now())

  userId    String
  userLabel String

  ofId      String?
  entity    String
  entityId  String

  meaning   String
  reason    String
  ipAddress String?

  user User             @relation(fields: [userId], references: [id])
  of   OrdreFabrication? @relation(fields: [ofId], references: [id])

  @@index([entity, entityId])
}
